// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShipmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ShipmentType {
  IMPORT
  EXPORT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Shipment {
  id              String         @id @default(uuid())
  jobNo           String         @unique
  blNo            String
  consignee       String
  shipper         String
  vessel          String
  portOfLoading   String
  portOfDischarge String
  eta             DateTime
  etd             DateTime
  etb             DateTime?
  openCy          DateTime?
  closeSi         DateTime?
  closeCy         DateTime?
  type            ShipmentType   @default(IMPORT)
  currentStep     Int            @default(0) // Matches your current Int setup
  nextAction      String         @default("Check ETA & Port") // <-- ADD THIS LINE HERE
  status          ShipmentStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tasks        ShipmentTask[]
  reminders    Reminder[]
  activityLogs ActivityLog[]
  todos        Todo[]

  @@index([status])
  @@index([eta])
  @@index([jobNo])
}

model ActivityLog {
  id         String   @id @default(uuid())
  shipmentId String
  message    String
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([createdAt])
}

model ShipmentTask {
  id          String    @id @default(uuid())
  shipmentId  String
  title       String
  stepOrder   Int
  completed   Boolean   @default(false)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, stepOrder])
  @@index([shipmentId])
}

model Reminder {
  id         String   @id @default(uuid())
  shipmentId String
  title      String
  dueDate    DateTime
  completed  Boolean  @default(false)
  priority   Priority @default(MEDIUM)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([completed, dueDate])
}

model Todo {
  id         String   @id @default(uuid())
  shipmentId String
  text       String
  isDone     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model DailyTodo {
  id        String   @id @default(uuid())
  text      String
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TerminalMonitor {
  id          String   @id @default(uuid())
  containerNo String   @unique
  waNumber    String?
  vesselName  String?
  voyageNo    String?
  port        String   @default("jict")
  status      String   @default("ONVSL")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model SystemConfig {
  key       String   @id
  value     String   // Store JSON stringified data
  updatedAt DateTime @updatedAt
}

model WaSubscription {
  id            String   @id @default(uuid())
  targetId      String   @unique // WA Number (e.g. 628123456789@c.us) or Group ID (120363...@g.us)
  name          String   // Client / Group Name
  plan          String   @default("STARTER") // STARTER, BUSINESS, ENTERPRISE, UNLIMITED
  maxContainers Int      @default(10) // Max active monitored containers allowed (0 = Unlimited)
  expiredAt     DateTime // Subscription expiration date
  isActive      Boolean  @default(true) // Active/Suspended status toggle
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([targetId])
  @@index([isActive, expiredAt])
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // Hashed with bcrypt
  name      String   // Full Name (e.g. "Muhamad Andri")
  role      String   @default("ADMIN") // ADMIN, CS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
}

model VesselMonitor {
  id            String    @id @default(uuid())
  vesselName    String
  port          String    @default("npct1")
  line          String?
  voyageIn      String?
  voyageOut     String?
  service       String?
  status        String    @default("REGISTER")
  etb           DateTime?
  ata           DateTime?
  etd           DateTime?
  atd           DateTime?
  openStacking  DateTime?
  closingDoc    DateTime?
  closingPhysic DateTime?
  waNumber      String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([vesselName, port])
  @@index([isActive])
  @@index([port, vesselName])
}




